import discord
from discord import app_commands

intents = discord.Intents.default()
client = discord.Client(intents=intents)
tree = app_commands.CommandTree(client)

@client.event
async def on_ready():
    guild = discord.Object(id=1522894609506893884)

    tree.clear_commands(guild=guild)
    await tree.sync(guild=guild)

    tree.copy_global_to(guild=guild)
    await tree.sync(guild=guild)

@tree.command(name="ping", description="проверка")
async def ping(interaction: discord.Interaction):
    await interaction.response.send_message("жопа")

@tree.command(name="obfuscate", description="обфускатор")
@app_commands.describe(code="вставь код")
async def obfuscate(interaction: discord.Interaction, code: str):
    import discord
    import io
    import json
    import os
    import re
    import secrets
    import struct
    import subprocess
    import tempfile

    if not code.strip():
        await interaction.response.send_message("Код пустой.")
        return

    if len(code.encode("utf-8")) > 300_000:
        await interaction.response.send_message("Код слишком большой.")
        return

    source_file = tempfile.NamedTemporaryFile(
        "w",
        suffix=".lua",
        delete=False,
        encoding="utf-8",
        newline=""
    )

    source_path = source_file.name
    source_file.write(code)
    source_file.close()

    try:
        # ============================================================
        # STEP 1
        # AST -> поиск строк
        # ============================================================

        ast_result = subprocess.run(
            ["luau-ast.exe", source_path],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=15
        )

        if ast_result.returncode != 0:
            await interaction.response.send_message(
                f"Ошибка AST:\n```text\n{ast_result.stderr[:1800]}\n```"
            )
            return

        try:
            ast = json.loads(ast_result.stdout)
        except json.JSONDecodeError as e:
            await interaction.response.send_message(
                f"AST вернул некорректный JSON:\n```text\n{str(e)[:1800]}\n```"
            )
            return

        strings = []
        globals_found = []
        calls_found = []

        def visit(node):
            if isinstance(node, dict):
                node_type = node.get("type")

                if node_type == "AstExprConstantString":
                    value = node.get("value")

                    if isinstance(value, str):
                        strings.append({
                            "value": value,
                            "location": node.get("location", "")
                        })

                elif node_type == "AstExprGlobal":
                    name = node.get("global")

                    if isinstance(name, str):
                        globals_found.append(name)

                elif node_type == "AstExprCall":
                    func = node.get("func")

                    if isinstance(func, dict):
                        if func.get("type") == "AstExprGlobal":
                            name = func.get("global")

                            if isinstance(name, str):
                                calls_found.append(name)

                for value in node.values():
                    visit(value)

            elif isinstance(node, list):
                for value in node:
                    visit(value)

        visit(ast)

        # ============================================================
        # STEP 2
        # Шифрование строк прямо в исходнике
        # ============================================================

        source_bytes = code.encode("utf-8")
        source_lines = code.splitlines(keepends=True)

        line_char_start = [0]
        line_byte_start = [0]
        line_char_to_byte = []

        char_pos = 0
        byte_pos = 0

        for line in source_lines:
            mapping = [0]
            current = 0

            for ch in line:
                current += len(ch.encode("utf-8"))
                mapping.append(current)

            line_char_to_byte.append(mapping)

            char_pos += len(line)
            byte_pos += len(line.encode("utf-8"))

            line_char_start.append(char_pos)
            line_byte_start.append(byte_pos)

        def location_to_offsets(location):
            match = re.fullmatch(
                r"\s*(\d+),(\d+)\s*-\s*(\d+),(\d+)\s*",
                location
            )

            if not match:
                return None

            sl, sc, el, ec = map(int, match.groups())

            if sl >= len(line_char_to_byte) or el >= len(line_char_to_byte):
                return None

            candidates = []

            # Вариант 1: column считается символами
            if (
                sc < len(line_char_to_byte[sl]) and
                ec < len(line_char_to_byte[el])
            ):
                start = line_byte_start[sl] + line_char_to_byte[sl][sc]
                end = line_byte_start[el] + line_char_to_byte[el][ec]
                candidates.append((start, end))

            # Вариант 2: column считается байтами UTF-8
            start = line_byte_start[sl] + sc
            end = line_byte_start[el] + ec

            candidates.append((start, end))

            for start, end in candidates:
                if start < 0 or end < start or end > len(source_bytes):
                    continue

                try:
                    raw = source_bytes[start:end].decode("utf-8")
                except UnicodeDecodeError:
                    continue

                if len(raw) < 2:
                    continue

                if (
                    (raw[0] == '"' and raw[-1] == '"') or
                    (raw[0] == "'" and raw[-1] == "'") or
                    (raw[0] == "[" and raw.endswith("]"))
                ):
                    return start, end

            return None

        unique_strings = {}
        replacements = []

        for item in strings:
            value = item["value"]

            if value not in unique_strings:
                key_a = secrets.randbelow(256)
                key_b = secrets.randbelow(256)

                encrypted = bytes(
                    (((byte ^ key_a) + key_b) & 0xFF)
                    for byte in value.encode("utf-8")
                )

                unique_strings[value] = {
                    "hex": encrypted.hex(),
                    "a": key_a,
                    "b": key_b
                }

            offsets = location_to_offsets(item["location"])

            if offsets is None:
                raise ValueError(
                    f"Не удалось определить положение строки: {item['location']}"
                )

            replacements.append(
                (
                    offsets[0],
                    offsets[1],
                    value
                )
            )

        # Случайный порядок таблицы строк
        string_entries = list(unique_strings.items())
        secrets.SystemRandom().shuffle(string_entries)

        string_ids = {
            value: index + 1
            for index, (value, _) in enumerate(string_entries)
        }

        # Заменяем строки справа налево
        replacements.sort(key=lambda x: x[0], reverse=True)

        mutated_bytes = bytearray(source_bytes)

        string_decoder_name = "__s_" + secrets.token_hex(6)
        string_table_name = "__t_" + secrets.token_hex(6)
        string_cache_name = "__c_" + secrets.token_hex(6)

        for start, end, value in replacements:
            replacement = (
                f"{string_decoder_name}({string_ids[value]})"
            ).encode("utf-8")

            mutated_bytes[start:end] = replacement

        mutated_source = mutated_bytes.decode("utf-8")

        # ============================================================
        # Сохраняем Luau directives в самом начале
        # ============================================================

        lines = mutated_source.splitlines(keepends=True)
        directive_lines = []
        body_start = 0

        while body_start < len(lines):
            stripped = lines[body_start].lstrip()

            if stripped.startswith("--!"):
                directive_lines.append(lines[body_start])
                body_start += 1
            else:
                break

        body = "".join(lines[body_start:])

        localized_tonumber = "__n_" + secrets.token_hex(5)
        localized_sub = "__sub_" + secrets.token_hex(5)
        localized_char = "__char_" + secrets.token_hex(5)
        localized_xor = "__xor_" + secrets.token_hex(5)
        localized_concat = "__concat_" + secrets.token_hex(5)
        localized_create = "__create_" + secrets.token_hex(5)

        string_table = []

        for _, data in string_entries:
            string_table.append(
                f'{{"{data["hex"]}",{data["a"]},{data["b"]}}}'
            )

        string_prologue = f"""
local {localized_tonumber} = tonumber
local {localized_sub} = string.sub
local {localized_char} = string.char
local {localized_xor} = bit32.bxor
local {localized_concat} = table.concat
local {localized_create} = table.create

local {string_table_name} = {{
    {",".join(string_table)}
}}

local {string_cache_name} = {{}}

local function {string_decoder_name}(index)
    local cached = {string_cache_name}[index]

    if cached ~= nil then
        return cached
    end

    local entry = {string_table_name}[index]
    local hex = entry[1]
    local keyA = entry[2]
    local keyB = entry[3]

    local out = {localized_create}(#hex // 2)
    local count = 0

    for position = 1, #hex, 2 do
        count += 1

        local encrypted = {localized_tonumber}(
            {localized_sub}(hex, position, position + 1),
            16
        )

        local value = {localized_xor}(
            (encrypted - keyB) % 256,
            keyA
        )

        out[count] = {localized_char}(value)
    end

    local result = {localized_concat}(out)

    {string_cache_name}[index] = result

    return result
end
""".strip()

        if directive_lines:
            mutated_source = (
                "".join(directive_lines) +
                "\n" +
                string_prologue +
                "\n\n" +
                body
            )
        else:
            mutated_source = (
                string_prologue +
                "\n\n" +
                body
            )

        with open(source_path, "w", encoding="utf-8", newline="") as f:
            f.write(mutated_source)

        # ============================================================
        # STEP 3
        # Luau source -> настоящий bytecode
        # ============================================================

        compiled = subprocess.run(
            [
                "luau-compile.exe",
                "--binary",
                "-O2",
                "-g0",
                "-t0",
                source_path
            ],
            capture_output=True,
            timeout=20
        )

        if compiled.returncode != 0:
            error = compiled.stderr.decode(
                "utf-8",
                errors="replace"
            )

            await interaction.response.send_message(
                f"Ошибка компиляции:\n```text\n{error[:1800]}\n```"
            )
            return

        bytecode = bytearray(compiled.stdout)

        if not bytecode:
            await interaction.response.send_message(
                "Компилятор вернул пустой bytecode."
            )
            return

        # ============================================================
        # STEP 3.5
        # Перемешивание opcode
        #
        # Fiu decodeOp() получает полный instruction word.
        # opcode находится в младшем байте.
        # Остальные 24 бита НЕ трогаем.
        # ============================================================

        opcode_permutation = list(range(256))
        secrets.SystemRandom().shuffle(opcode_permutation)

        opcode_inverse = [0] * 256

        for original, encoded in enumerate(opcode_permutation):
            opcode_inverse[encoded] = original

        # Текущий opList Fiu / Luau.
        #
        # Сюда входят инструкции, за которыми идёт AUX word.
        #
        aux_opcodes = {
            7,   # GETGLOBAL
            8,   # SETGLOBAL
            12,  # GETIMPORT
            15,  # GETTABLEKS
            16,  # SETTABLEKS
            20,  # NAMECALL
            53,  # NEWTABLE
            55,  # SETLIST
            58,  # FORGLOOP
            60,  # FASTCALL3
            66,  # LOADKX
            74,  # FASTCALL2
            75,  # FASTCALL2K
            77,  # JUMPXEQKNIL
            78,  # JUMPXEQKB
            79,  # JUMPXEQKN
            80,  # JUMPXEQKS
        }

        cursor = 0

        def ensure(size):
            if cursor + size > len(bytecode):
                raise ValueError(
                    "Bytecode повреждён или имеет неизвестный формат."
                )

        def read_u8():
            nonlocal cursor
            ensure(1)

            value = bytecode[cursor]
            cursor += 1

            return value

        def read_u32():
            nonlocal cursor
            ensure(4)

            value = struct.unpack_from(
                "<I",
                bytecode,
                cursor
            )[0]

            cursor += 4

            return value

        def read_varint():
            nonlocal cursor

            result = 0
            shift = 0

            for _ in range(5):
                value = read_u8()

                result |= (value & 0x7F) << shift

                if not (value & 0x80):
                    return result

                shift += 7

            raise ValueError("Некорректный varint в bytecode.")

        
        # ---------------------------------------------------------
        # Luau bytecode v3-v14
        # ---------------------------------------------------------

        luau_version = read_u8()

        if luau_version < 3 or luau_version > 14:
            raise ValueError(
                f"Версия Luau bytecode {luau_version} "
                f"не поддерживается."
            )

        types_version = 0

        if luau_version >= 4:
            types_version = read_u8()

        # ---------------------------------------------------------
        # String table
        # ---------------------------------------------------------

        string_count = read_varint()

        for _ in range(string_count):
            size = read_varint()
            ensure(size)
            cursor += size

        # ---------------------------------------------------------
        # Userdata type remapping
        # ---------------------------------------------------------

        if types_version == 3:
            while True:
                index = read_u8()

                if index == 0:
                    break

                read_varint()

        # ---------------------------------------------------------
        # Proto count
        # ---------------------------------------------------------

        proto_count = read_varint()

        # ---------------------------------------------------------
        # Newer Luau versions use additional instructions.
        #
        # These instructions consume an AUX word after the
        # instruction itself.
        # ---------------------------------------------------------

        aux_opcodes_v14 = {
            # old AUX opcodes
            7,    # GETGLOBAL
            8,    # SETGLOBAL
            12,   # GETIMPORT
            15,   # GETTABLEKS
            16,   # SETTABLEKS
            21,   # NAMECALL
            32,   # NEWTABLE
            35,   # SETLIST
            41,   # FASTCALL3
            49,   # LOADKX
            53,   # FASTCALL2
            54,   # FASTCALL2K
            63,   # JUMPXEQKNIL
            64,   # JUMPXEQKB
            65,   # JUMPXEQKN
            66,   # JUMPXEQKS

            # v10+
            86,   # NEWCLASSMEMBER

            # v11+
            87,   # CALLFB
            88,   # CMPPROTO

            # v9+
            83,   # GETUDATAKS
            84,   # SETUDATAKS
            85,   # NAMECALLUDATA

            # v100 / class bytecode
            90,   # NEWCLASS
        }

        # ---------------------------------------------------------
        # Parse every proto
        # ---------------------------------------------------------

        for _ in range(proto_count):

            # v12+ stores the serialized size of every proto
            if luau_version >= 12:
                proto_size = read_varint()

            # Proto header
            read_u8()  # maxstacksize
            read_u8()  # numparams
            read_u8()  # nups
            read_u8()  # isvararg

            # v4+
            if luau_version >= 4:
                read_u8()  # flags

                types_size = read_varint()
                ensure(types_size)
                cursor += types_size

            # -----------------------------------------------------
            # Instructions
            # -----------------------------------------------------

            sizecode = read_varint()

            for _ in range(sizecode):

                instruction_position = cursor
                instruction = read_u32()

                original_opcode = instruction & 0xFF

                # Current Luau has 91 opcodes: 0..90
                if original_opcode > 90:
                    raise ValueError(
                        f"Неизвестный opcode {original_opcode}. "
                        f"Bytecode parser не знает этот opcode."
                    )

                encoded_opcode = opcode_permutation[original_opcode]

                encoded_instruction = (
                    instruction & 0xFFFFFF00
                ) | encoded_opcode

                struct.pack_into(
                    "<I",
                    bytecode,
                    instruction_position,
                    encoded_instruction
                )

                # AUX is another 32-bit instruction word.
                if original_opcode in aux_opcodes_v14:
                    read_u32()

            # -----------------------------------------------------
            # Constants
            # -----------------------------------------------------

            constant_count = read_varint()

            for _ in range(constant_count):

                constant_type = read_u8()

                if constant_type == 0:
                    # nil
                    pass

                elif constant_type == 1:
                    # boolean
                    read_u8()

                elif constant_type == 2:
                    # number
                    ensure(8)
                    cursor += 8

                elif constant_type == 3:
                    # string
                    read_varint()

                elif constant_type == 4:
                    # import
                    read_u32()

                elif constant_type == 5:
                    # table
                    data_length = read_varint()

                    for _ in range(data_length):
                        read_varint()

                elif constant_type == 6:
                    # closure
                    read_varint()

                elif constant_type == 7:
                    # Vector<float>
                    ensure(16)
                    cursor += 16

                elif constant_type == 8:
                    # TABLE_WITH_CONSTANTS
                    data_length = read_varint()

                    for _ in range(data_length):
                        read_varint()  # key
                        read_u32()     # constant index

                elif constant_type == 9:
                    # INTEGER
                    negative = read_u8()
                    value = read_varint()

                elif constant_type == 10:
                    # CLASS_SHAPE
                    #
                    # class name
                    read_varint()

                    # property count
                    property_count = read_varint()

                    # method count
                    method_count = read_varint()

                    for _ in range(property_count):
                        read_varint()

                    for _ in range(method_count):
                        read_varint()

                elif constant_type == 11:
                    # Vector<double>
                    ensure(32)
                    cursor += 32

                else:
                    raise ValueError(
                        f"Неизвестный тип константы {constant_type}."
                    )

            # -----------------------------------------------------
            # Child prototypes
            # -----------------------------------------------------

            prototype_count = read_varint()

            for _ in range(prototype_count):
                read_varint()

            # -----------------------------------------------------
            # Debug information
            # -----------------------------------------------------

            read_varint()  # linedefined
            read_varint()  # debugnameindex

            # -----------------------------------------------------
            # Line info
            # -----------------------------------------------------

            lineinfo_enabled = read_u8() != 0

            if lineinfo_enabled:

                linegaplog2 = read_u8()

                if sizecode == 0:
                    intervals = 0
                else:
                    intervals = (
                        ((sizecode - 1) >> linegaplog2) + 1
                    )

                # delta line info
                ensure(sizecode)
                cursor += sizecode

                # absolute line info
                ensure(intervals * 4)
                cursor += intervals * 4

            # -----------------------------------------------------
            # Debug locals/upvalues
            # -----------------------------------------------------

            debuginfo_enabled = read_u8() != 0

            if debuginfo_enabled:

                local_count = read_varint()

                for _ in range(local_count):
                    read_varint()  # name
                    read_varint()  # startpc
                    read_varint()  # endpc
                    read_u8()      # register

                upvalue_count = read_varint()

                for _ in range(upvalue_count):
                    read_varint()

            # -----------------------------------------------------
            # v11+ feedback vector
            # -----------------------------------------------------
            #
            # CALLFB/CMPPROTO use feedback slots.
            # The vector description is serialized after debug info.
            #
            # We only need to preserve/skip it here; the actual VM
            # will handle the feedback data.
            # -----------------------------------------------------

            if luau_version >= 11:
                feedback_count = read_varint()

                for _ in range(feedback_count):
                    read_varint()

            # -----------------------------------------------------
            # v12+ cost function
            # -----------------------------------------------------

            if luau_version >= 12:
                cost_size = read_varint()

                ensure(cost_size)
                cursor += cost_size

        # ---------------------------------------------------------
        # Main proto
        # ---------------------------------------------------------

        read_varint()  # main proto id

        if cursor != len(bytecode):
            raise ValueError(
                f"Bytecode cursor mismatch: "
                f"{cursor}/{len(bytecode)}"
            )
        # ============================================================
        # STEP 4
        # Дополнительное кодирование всего payload
        # ============================================================

        stream_seed = secrets.randbits(32)

        if stream_seed == 0:
            stream_seed = 1

        encrypted_bytecode = bytearray(len(bytecode))

        state = stream_seed

        for index, value in enumerate(bytecode):
            state = (
                state * 1664525 +
                1013904223
            ) & 0xFFFFFFFF

            encrypted_bytecode[index] = (
                value ^ (state & 0xFF)
            )

        payload_hex = encrypted_bytecode.hex()

        # Большие случайные chunks
        rng = secrets.SystemRandom()

        chunk_size = rng.randrange(512, 1025) * 2

        chunks = {}

        for position in range(0, len(payload_hex), chunk_size):
            key = rng.randrange(
                100_000_000_000,
                8_000_000_000_000_000
            )

            while key in chunks:
                key = rng.randrange(
                    100_000_000_000,
                    8_000_000_000_000_000
                )

            chunks[key] = payload_hex[
                position:position + chunk_size
            ]

        chunk_order = list(chunks.keys())
        rng.shuffle(chunk_order)

        shuffled_chunks = list(chunks.items())
        rng.shuffle(shuffled_chunks)

        # ============================================================
        # STEP 5
        # Финальная VM-обвязка
        # ============================================================

        tag = secrets.token_hex(8)

        vm_name = f"__v_{tag}"
        hex_decoder_name = f"__h_{tag}"
        chunks_name = f"__p_{tag}"
        order_name = f"__o_{tag}"
        parts_name = f"__q_{tag}"
        encrypted_name = f"__e_{tag}"
        state_name = f"__x_{tag}"
        decoded_name = f"__d_{tag}"
        settings_name = f"__s_{tag}"
        runner_name = f"__r_{tag}"
        close_name = f"__c_{tag}"
        result_name = f"__z_{tag}"
        inverse_name = f"__i_{tag}"

        inverse_table = ",".join(
            str(value)
            for value in opcode_inverse
        )

        chunk_table = ",\n".join(
            f"[{key}]=\"{value}\""
            for key, value in shuffled_chunks
        )

        order_table = ",".join(
            str(key)
            for key in chunk_order
        )

        final_lua = f'''-- generated by obfuscator
-- VM: vluau

local {vm_name} = require("vluau")

local {localized_sub} = string.sub
local {localized_tonumber} = tonumber
local {localized_char} = string.char
local {localized_concat} = table.concat
local {localized_create} = table.create

local function {hex_decoder_name}(value)
    local result = {localized_create}(#value // 2)
    local count = 0

    for i = 1, #value, 2 do
        count += 1
        result[count] = {localized_char}(
            {localized_tonumber}(
                {localized_sub}(value, i, i + 1),
                16
            )
        )
    end

    return {localized_concat}(result)
end

local {chunks_name} = {{
    {chunk_table}
}}

local {order_name} = {{
    {order_table}
}}

local {parts_name} = {localized_create}(#{order_name})

for i = 1, #{order_name} do
    {parts_name}[i] = {hex_decoder_name}(
        {chunks_name}[{order_name}[i]]
    )
end

local {encrypted_name} = {localized_concat}({parts_name})

local {state_name} = {stream_seed}
local {decoded_name} = {localized_create}(#{encrypted_name})

for i = 1, #{encrypted_name} do
    {state_name} = (
        {state_name} * 1664525 +
        1013904223
    ) % 4294967296

    {decoded_name}[i] = {localized_char}(
        bit32.bxor(
            string.byte({encrypted_name}, i),
            bit32.band({state_name}, 255)
        )
    )
end

local {decoded_name} = {localized_concat}({decoded_name})

local {inverse_name} = {{
    {inverse_table}
}}

local {settings_name} = {vm_name}.luau_newsettings()

{settings_name}.decodeOp = function(op)
    local low = bit32.band(op, 255)

    return bit32.bor(
        op - low,
        {inverse_name}[low + 1]
    )
end

local {runner_name}, {close_name} = {vm_name}.luau_load(
    {decoded_name},
    _ENV,
    {settings_name}
)

local {result_name} = table.pack(
    pcall({runner_name})
)

{close_name}()

if not {result_name}[1] then
    error({result_name}[2], 0)
end

return table.unpack(
    {result_name},
    2,
    {result_name}.n
)
'''

        output_file = discord.File(
            io.BytesIO(final_lua.encode("utf-8")),
            filename=f"obfuscated_{tag}.lua"
        )

        await interaction.response.send_message(
            content=(
                f"Готово.\n"
                f"Строк обработано: {len(unique_strings)}\n"
                f"AST globals: {len(globals_found)}\n"
                f"AST calls: {len(calls_found)}\n"
                f"Bytecode: {len(bytecode)} байт"
            ),
            file=output_file
        )

    except subprocess.TimeoutExpired:
        if not interaction.response.is_done():
            await interaction.response.send_message(
                "Операция превысила лимит времени."
            )

    except FileNotFoundError as e:
        if not interaction.response.is_done():
            await interaction.response.send_message(
                f"Не найден executable:\n```text\n{e.filename}\n```"
            )

    except Exception as e:
        if not interaction.response.is_done():
            await interaction.response.send_message(
                f"Ошибка обфускатора:\n```text\n{str(e)[:1800]}\n```"
            )

    finally:
        try:
            os.unlink(source_path)
        except OSError:
            pass

@tree.command(name="compilator", description="компилятор Luau")
@app_commands.describe(
    mode="режим компиляции",
    code="вставь код",
    opt="уровень оптимизации (0-2)",
    debug="уровень отладки (0-2)",
    type_info="уровень информации о типах (0-1)",
    target="целевая архитектура",
    timetrace="записывать тайминг в trace.json",
    bytecode_summary="статистика операций байт-кода",
    dump_constants="дамп таблицы констант",
    dump_regspills="события выгрузки регистров",
    only_parse="только парсинг",
    parse_cst="парсить CST вместе с AST"
)
@app_commands.choices(
    mode=[
        app_commands.Choice(name="binary", value="binary"),
        app_commands.Choice(name="text", value="text"),
    ],
    target=[
        app_commands.Choice(name="x64", value="x64"),
        app_commands.Choice(name="a64", value="a64"),
        app_commands.Choice(name="x64_ms", value="x64_ms"),
        app_commands.Choice(name="a64_nf", value="a64_nf"),
    ]
)
async def compilator(
    interaction: discord.Interaction,
    mode: str,
    code: str,
    opt: int = 1,
    debug: int = 1,
    type_info: int = 0,
    target: str = None,
    timetrace: bool = False,
    bytecode_summary: bool = False,
    dump_constants: bool = False,
    dump_regspills: bool = False,
    only_parse: bool = False,
    parse_cst: bool = False
):
    f = __import__("tempfile").NamedTemporaryFile(
        "w", suffix=".lua", delete=False, encoding="utf-8"
    )
    f.write(code)
    f.close()

    cmd = [
        "luau-compile",
        f"--{mode}",
        f"-O{opt}",
        f"-g{debug}",
        f"-t{type_info}"
    ]

    if target:
        cmd.append(f"--target={target}")
    if timetrace:
        cmd.append("--timetrace")
    if bytecode_summary:
        cmd.append("--bytecode-summary")
    if dump_constants:
        cmd.append("--dump-constants")
    if dump_regspills:
        cmd.append("--dump-regspills")
    if only_parse:
        cmd.append("--only-parse")
    if parse_cst:
        cmd.append("--parse-cst")

    result = __import__("subprocess").run(
        cmd + [f.name],
        capture_output=True,
        text=True
    )

    output = result.stdout if result.returncode == 0 else f"Ошибка:\n{result.stderr}"

    await interaction.response.send_message(
        f"*исходный код*\n```lua\n{code}\n```\n"
        f"*скомпилированный код ({mode})*\n```text\n{output}\n```"
    )
